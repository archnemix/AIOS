[Unit]
Description=AIOS inference gateway
After=network.target

[Service]
Type=simple
User=aios
Group=aios
WorkingDirectory=/opt/aios
EnvironmentFile=/etc/aios/gateway.env
ExecStart=/usr/bin/python3 -m aios serve
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
