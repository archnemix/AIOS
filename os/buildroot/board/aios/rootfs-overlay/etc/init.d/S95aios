#!/bin/sh
CONFIG=/etc/aios/server.conf
PIDFILE=/var/run/aios.pid
DATA=/data

start() {
    . "$CONFIG"
    # Boot profiles are trusted local configuration; network is always opt-in.
    for arg in $(cat /proc/cmdline); do
        case "$arg" in
            aios.network=1) AIOS_LISTEN=0.0.0.0 ;;
            aios.threads=2) AIOS_THREADS=2 ;;
            aios.autotune=1) AIOS_THREADS=autotune ;;
            aios.ubatch=128) AIOS_UBATCH=128 ;;
            aios.context=16k) AIOS_CONTEXT=16384; AIOS_ROPE_MODE=linear2 ;;
            aios.context=32k) AIOS_CONTEXT=32768; AIOS_ROPE_MODE=model ;;
            aios.external=1) AIOS_MODEL_MODE=external; AIOS_DATA_DEVICE=/dev/vda ;;
        esac
    done
    case "$AIOS_MODEL_MODE" in
        embedded)
            MODEL=/opt/aios/model.gguf
            mkdir -p /run/aios
            chmod 755 /run/aios
            rm -f /run/aios/api.key
            if ! /usr/bin/aios-keygen /run/aios/api.key 1000; then
                echo "AIOS: failed to generate API key" >&2; return 1
            fi
            KEY=/run/aios/api.key
            ;;
        external)
            mkdir -p "$DATA"
            if ! mount -t ext4 -o ro,nosuid,nodev,noexec "$AIOS_DATA_DEVICE" "$DATA"; then
                echo "AIOS: unable to mount model volume" >&2; return 1
            fi
            MODEL=$DATA/model.gguf
            KEY=$DATA/api.key
            ;;
        *) echo "AIOS: invalid model mode" >&2; return 1 ;;
    esac
    if [ ! -f "$MODEL" ] || ! /usr/libexec/aios-validate-key "$KEY"; then
        echo "AIOS: model and one 32-128 character URL-safe API key required" >&2
        [ "$AIOS_MODEL_MODE" = external ] && umount "$DATA"
        return 1
    fi
    /usr/bin/aios-hardware --report
    VARIANT=$(/usr/libexec/aios-select-backend)
    BACKEND=/usr/bin/llama-server
    if [ "$VARIANT" = avx2 ] && [ -x /usr/bin/llama-server-avx2 ]; then
        BACKEND=/usr/bin/llama-server-avx2
    else
        VARIANT=portable
    fi
    if [ "$AIOS_THREADS" = autotune ]; then
        echo "AIOS: measuring generation thread counts (up to 180 seconds)"
        if tuned=$(/usr/libexec/aios-tune-threads "$MODEL" "$VARIANT"); then
            AIOS_THREADS=$tuned
            echo "AIOS: tuning selected $AIOS_THREADS threads"
        else
            AIOS_THREADS=auto
        fi
    fi
    if [ "$AIOS_THREADS" = auto ]; then
        AIOS_THREADS=$(/usr/bin/aios-hardware --threads) || return 1
    fi
    # Reject oversized requests by default rather than silently dropping input.
    # Context shift remains an explicit trusted-configuration choice.
    set -- --threads "$AIOS_THREADS" --ctx-size "$AIOS_CONTEXT" --no-webui
    case "${AIOS_ROPE_MODE:-model}" in
        model) ;;
        linear2)
            if [ "$AIOS_CONTEXT" != 16384 ]; then
                echo "AIOS: linear2 requires a 16384-token context" >&2; return 1
            fi
            set -- "$@" --rope-scaling linear --rope-scale 2
            echo "AIOS: experimental 16k context; quality beyond training length is not guaranteed"
            ;;
        *) echo "AIOS: invalid AIOS_ROPE_MODE" >&2; return 1 ;;
    esac
    case "${AIOS_UBATCH:-auto}" in
        auto) ;;
        128) set -- "$@" --ubatch-size 128 ;;
        *) echo "AIOS: AIOS_UBATCH must be auto or 128" >&2; return 1 ;;
    esac
    case "${AIOS_CONTEXT_SHIFT:-0}" in
        0) set -- "$@" --no-context-shift ;;
        1) ;;
        *) echo "AIOS: AIOS_CONTEXT_SHIFT must be 0 or 1" >&2; return 1 ;;
    esac
    echo "AIOS: inference backend=$VARIANT threads=$AIOS_THREADS"
    echo "AIOS: prompt microbatch=${AIOS_UBATCH:-auto}"
    echo "AIOS: context=$AIOS_CONTEXT rope=${AIOS_ROPE_MODE:-model} model_mode=$AIOS_MODEL_MODE"
    if [ -r /sys/kernel/mm/transparent_hugepage/enabled ]; then
        echo "AIOS: transparent hugepage policy=$(cat /sys/kernel/mm/transparent_hugepage/enabled)"
    else
        echo "AIOS: transparent hugepage policy=unavailable"
    fi
    if ! start-stop-daemon -S -b -m -p "$PIDFILE" -c aios \
        -x "$BACKEND" -- \
        -m "$MODEL" --api-key-file "$KEY" \
        --host "$AIOS_LISTEN" --port "$AIOS_PORT" \
        "$@"; then
        echo "AIOS: unable to start server" >&2
        [ "$AIOS_MODEL_MODE" = external ] && umount "$DATA"
        return 1
    fi
    echo "AIOS: starting at http://$AIOS_LISTEN:$AIOS_PORT (model loading may take time)"
    if [ "$AIOS_MODEL_MODE" = embedded ]; then
        echo "AIOS_BOOT_TOKEN=$(cat "$KEY")"
        echo "AIOS: keep this token private; it changes on every boot."
    fi
}
stop() {
    for executable in /usr/bin/llama-server /usr/bin/llama-server-avx2; do
        start-stop-daemon -K -p "$PIDFILE" -x "$executable" 2>/dev/null && break
    done
    rm -f "$PIDFILE"
    umount "$DATA" 2>/dev/null || :
}
case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    *) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac
